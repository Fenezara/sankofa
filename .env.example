# ============================================================
# Sankofa — Environment Variables Template
# ============================================================
# Copy to .env and fill values. Never commit .env (gitignored).
#
# Required for dev :
#   - DATABASE_URL
#   - NEXTAUTH_SECRET
#   - NEXTAUTH_URL
#
# Optional (production features) :
#   - CinetPay (Mobile Money payments)
#   - WhatsApp Business Cloud API (outbound messages)
#   - Web Push VAPID keys (notifications)
#   - Google Maps API (TPE centers geocoding — optional)
# ============================================================

# --- Database (SQLite dev / PostgreSQL production) ---
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# --- NextAuth.js ---
NEXTAUTH_SECRET="aya-dev-secret-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# --- CinetPay (Mobile Money — production only) ---
# Dev mode : si absents → simulation (transaction pending en DB, pas d'URL)
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_NOTIFY_URL="https://sankofa.ci/api/payment/webhook"
CINETPAY_RETURN_URL="https://sankofa.ci/?payment=done"

# --- WhatsApp Business Cloud API (production only) ---
# Dev mode : si absents → console.log seulement
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="sankofa-verify-change-me"
WHATSAPP_BUSINESS_PHONE_ID=""

# --- Web Push (VAPID keys) ---
# Generate : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@sankofa.ci"

# --- z-ai-web-dev-sdk (LLM / ASR / TTS) ---
# Le SDK utilise les credentials via l'environnement — pas de clé explicite nécessaire en dev.
# ZAI_API_KEY=""  # si requis par votre provider

# --- App config ---
NEXT_PUBLIC_APP_NAME="Sankofa"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_VERSION="4.1.0"

# --- Feature flags (1=enabled, 0=disabled) V4 ---
NEXT_PUBLIC_FEATURE_AUDIO="1"           # ASR/TTS micro + écouter
NEXT_PUBLIC_FEATURE_TELECONSULT="1"     # Réservation visio médecin
NEXT_PUBLIC_FEATURE_TESTIMONIES="1"     # Témoignages anonymes modérés
NEXT_PUBLIC_FEATURE_SENTINEL="1"        # IA Sentinelle préventive
NEXT_PUBLIC_FEATURE_CYCLE="1"           # Calendrier menstruel chiffré
NEXT_PUBLIC_FEATURE_QUIZ="1"            # Quiz gamifié quotidien
NEXT_PUBLIC_FEATURE_CAREER="1"          # Orientation professionnelle santé
NEXT_PUBLIC_FEATURE_PREDIAGNOSTIC="1"   # Pré-diagnostic éducatif adaptatif
NEXT_PUBLIC_FEATURE_HARASSMENT="1"      # Détection harcèlement + cyberharcèlement

# --- z-ai-web-dev-sdk V4 — TTS voices (mapping persona → voice ID) ---
ZAI_TTS_VOICE_GRANDE_SOEUR="tongtong"
ZAI_TTS_VOICE_GRAND_FRERE="xiaochen"
ZAI_TTS_VOICE_TONTON_MEDECIN="luodo"
ZAI_TTS_PHONETIC_ENABLED="1"            # Pré-traitement phonétique FR

# --- Teleconsultation (V6 préparation) ---
TELECONSULTATION_DEFAULT_DURATION_MIN="30"
TELECONSULTATION_MEETING_PROVIDER="jitsi"
TELECONSULTATION_JITSI_DOMAIN="meet.jit.si"

# --- Analytics (V4) ---
ANALYTICS_RATE_LIMIT_PER_MIN="60"
ANALYTICS_RETENTION_DAYS="365"

# --- Sentinel (V4) ---
SENTINEL_CACHE_TTL_MIN="5"
SENTINEL_CHECK_INTERVAL_MESSAGES="5"
SENTINEL_DAILY_LIMIT="1"
